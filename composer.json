{
  "name": "panelis-php/branch",
  "description": "Manage branches to organize data and enable multi-tenant access within the application",
  "license": "MIT",
  "keywords": [
    "panelis"
  ],
  "type": "library",
  "require": {
    "php": "^8.4",
    "illuminate/support": "^13.0",
    "filament/filament": "^5.0",
    "panelis-php/activity": "^1.1"
  },
  "autoload": {
    "psr-4": {
      "Panelis\\Branch\\": "src/",
      "Panelis\\Branch\\Database\\Factories\\": "database/factories/",
      "Panelis\\Branch\\Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Panelis\\Branch\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "laravel/pint": "^1.29",
    "orchestra/testbench": "^11.0",
    "pestphp/pest": "^4.4",
    "pestphp/pest-plugin-laravel": "^4.1"
  },
  "scripts": {
    "test": "vendor/bin/pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Panelis\\Branch\\Providers\\BranchServiceProvider"
      ]
    },
    "panelis": {
      "plugins": [
        "Panelis\\Branch\\Plugins\\BranchPlugin"
      ]
    }
  }
}
